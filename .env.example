# Set a long, unique password before deployment.
ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters
# DeepSeek Platform API key. Without it, the built-in architecture-focused question set is used.
DEEPSEEK_API_KEY=
# DeepSeek's current latest V4.1 Flash model alias as of Oct 2026. API resolves this alias to its latest release.
DEEPSEEK_MODEL=deepseek-flash
NODE_ENV=production
PORT=4000
COOKIE_SECURE=true
