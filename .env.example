# Set a long, unique password before deployment.
ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters
# CloseRouter API key. Without it, the built-in architecture-focused question set is used.
CLOSEROUTER_API_KEY=
# Public model ID from https://closerouter.dev/models
CLOSEROUTER_MODEL=anthropic/claude-opus-4.8
NODE_ENV=production
PORT=4000
COOKIE_SECURE=true
